@media(max-width:600px){.spn-dialog{width:min(430px,calc(100vw - 20px));max-height:calc(100vh - 20px)}.spn-close{right:9px;top:9px;width:42px;height:42px;font-size:27px}.spn-hero{height:112px;min-height:112px}.spn-content{padding:0 18px 22px}.spn-title{margin-top:-22px;padding:11px 18px;font-size:19px}.spn-message{margin-top:17px;font-size:20px}.spn-submessage{font-size:17px}.spn-thanks{margin:16px -18px -22px;padding:13px 16px;font-size:17px}.spn-countdown-part{min-width:54px}.spn-countdown-part strong{font-size:18px}.spn-cta{width:100%}}
