</style>
<script>
(function(){
  'use strict';
  var root=document.querySelector('[data-furmedia-scheduled-popup="2"]');if(!root)return;
  function decode(value){try{return JSON.parse(decodeURIComponent(escape(atob(value))))}catch(error){return JSON.parse(atob(value))}}
  var campaigns=decode('<?php echo $campaigns_b64; ?>'),trackUrl=atob('<?php echo $track_url_b64; ?>'),labels=decode('<?php echo $labels_b64; ?>');
  var queue=campaigns.filter(function(c){try{return sessionStorage.getItem('spn_closed_'+c.id+'_'+c.occurrence_key)!=='1'}catch(error){return true}}),index=0,lastFocus=null,timer=null;
  if(!queue.length)return;
