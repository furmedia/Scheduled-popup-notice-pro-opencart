  function node(tag,className,text){var el=document.createElement(tag);if(className)el.className=className;if(text!=null)el.textContent=text;return el}
  function show(){clearInterval(timer);if(index>=queue.length){root.hidden=true;root.innerHTML='';if(lastFocus&&lastFocus.focus)lastFocus.focus();return}var c=queue[index];root.innerHTML='';root.dataset.preset=c.preset;root.style.setProperty('--spn-accent',c.accent_color);root.style.setProperty('--spn-bg',c.background_color);root.style.setProperty('--spn-text',c.text_color);root.style.setProperty('--spn-button',c.button_color);root.style.setProperty('--spn-overlay',c.overlay_color);root.style.setProperty('--spn-overlay-opacity',String(c.overlay_opacity/100));root.style.setProperty('--spn-blur',String(c.blur)+'px');var overlay=node('div','spn-overlay'),dialog=node('div','spn-dialog'),close=node('button','spn-close','Ã—'),hero=node('div','spn-hero'),image=node('img'),content=node('div','spn-content'),title=node('h2','spn-title',c.title),message=node('p','spn-message',c.message),divider=node('div','spn-divider'),sub=node('p','spn-submessage',c.submessage),thanks=node('div','spn-thanks',c.thanks);dialog.setAttribute('role','dialog');dialog.setAttribute('aria-modal','true');dialog.setAttribute('aria-labelledby','spn-title-'+c.id);title.id='spn-title-'+c.id;close.type='button';close.setAttribute('aria-label',labels.close);image.src=c.image;image.alt='';image.decoding='async';hero.appendChild(image);dialog.appendChild(close);dialog.appendChild(hero);content.appendChild(title);content.appendChild(message);content.appendChild(divider);content.appendChild(sub);if(c.countdown){var countdown=node('div','spn-countdown-wrap'),countdownLabel=node('span','spn-countdown-label',c.countdown_label),countdownGrid=node('div','spn-countdown');countdown.appendChild(countdownLabel);countdown.appendChild(countdownGrid);content.appendChild(countdown);updateCountdown(c,countdownGrid);timer=setInterval(function(){if(!updateCountdown(c,countdownGrid)){next(c,false)}},1000)}if(c.button_url&&c.button_text){var cta=node('a','spn-cta',c.button_text);cta.href=c.button_url;cta.target=c.button_target;cta.rel=c.button_target==='_blank'?'noopener noreferrer':'';cta.addEventListener('click',function(){track(c,'click')});content.appendChild(cta)}content.appendChild(thanks);dialog.appendChild(content);if(queue.length>1)dialog.appendChild(node('span','spn-progress',(index+1)+' / '+queue.length));root.appendChild(overlay);root.appendChild(dialog);if(lastFocus===null)lastFocus=document.activeElement;root.hidden=false;close.focus();close.addEventListener('click',function(){next(c,true)});document.addEventListener('keydown',escapeOnce);track(c,'impression')}
  function escapeOnce(event){if(event.key==='Escape'&&!root.hidden){var c=queue[index];next(c,true)}}
  function next(c,remember){clearInterval(timer);if(remember){try{sessionStorage.setItem('spn_closed_'+c.id+'_'+c.occurrence_key,'1')}catch(error){}track(c,'close')}index++;show()}
  function updateCountdown(c,container){var left=Math.max(0,Date.parse(c.countdown_end)-Date.now());if(left<=0){return false}var values=[Math.floor(left/86400000),Math.floor((left%86400000)/3600000),Math.floor((left%3600000)/60000),Math.floor((left%60000)/1000)],names=[labels.days,labels.hours,labels.minutes,labels.seconds];container.innerHTML='';values.forEach(function(value,i){var display=value<10?'0'+value:String(value),part=node('span','spn-countdown-part'),strong=node('strong','',display),small=node('small','',names[i]);part.appendChild(strong);part.appendChild(small);container.appendChild(part)});return true}
  if(document.body&&root.parentNode!==document.body)document.body.appendChild(root);show();
